<Project Sdk="Microsoft.NET.Sdk">

    <!-- Project level compilation properties -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>

    <!-- Project level package properties -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);KNI</DefineConstants>
        <PackageId>KNI.Aseprite.Content.Pipeline</PackageId>
        <Description>
            KNI.Aseprite.Content.Pipeline is a cross-platform C# library that adds an extension to the KNI
            MGCB Editor for importing Aseprite (.ase | .aseprite) files to be used in a KNI project using the
            KNI.Aseprite library.
        </Description>
    </PropertyGroup>

    <!-- Includes for the icons and README.md that are in the <PackageIcon> and <PackageReadMeFile> tags above -->
    <ItemGroup>
        <None Include="..\..\.images\nuget-icon.png" Pack="true" PackagePath="" />
        <None Include="..\..\.\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <!-- NuGet Package References -->
    <ItemGroup>
        <PackageReference Include="AsepriteDotNet" Version="1.9.1" />
        <PackageReference Include="nkast.Xna.Framework.Content.Pipeline" Version="$(KNIVersion)" />
        <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Graphics" Version="$(KNIVersion)" />
    </ItemGroup>
</Project>
